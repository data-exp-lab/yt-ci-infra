[Unit]
Description=yt answer-test controller: shelve the worker if left idle (backstop for the reconciler)
After=network-online.target

[Service]
Type=oneshot
User=yt-controller
Group=yt-controller
EnvironmentFile=/etc/yt-controller/env
WorkingDirectory=/opt/yt-controller
ExecStart=/opt/yt-controller/.venv/bin/yt-controller idle-shelver
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
