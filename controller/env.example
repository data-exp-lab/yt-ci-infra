# Copy to /etc/yt-controller/env, chmod 600, owned by root.
# Loaded by systemd via EnvironmentFile= for every yt-controller unit.

# Repository whose Actions queue is watched and whose runners are minted.
# Dev happens on the fork; switch to yt-project/yt at cut-over.
GITHUB_REPO=chavlin/yt

# Fine-grained personal access token (or GitHub App installation token) scoped to GITHUB_REPO only.
# Needs: Administration read/write (generate-jitconfig), Actions read (queue + runners).
GITHUB_TOKEN=github_pat_xxx

# Name of the cloud entry in ~/.config/openstack/clouds.yaml (application credential).
OS_CLOUD=jetstream

# OpenStack server name of the worker to shelve/unshelve. Created by infra/create.sh.
WORKER_NAME=yt-worker

# Runner label the yt workflow targets with runs-on: [self-hosted, jetstream].
RUNNER_LABEL=jetstream

# Reconciler: seconds of no queued/busy activity before shelving an ACTIVE worker.
GRACE_SECONDS=300

# Reconciler: seconds between GitHub polls.
POLL_SECONDS=45

# Idle shelver: independent, longer timeout. Shelves an ACTIVE worker whose OpenStack
# record has not changed for this long while nothing is queued or busy.
IDLE_SHELVE_SECONDS=1200

# Runner-config endpoint the worker hits at boot. Bind to the controller's private IP;
# the security group only admits the worker's group on this port.
TOKEN_BIND=0.0.0.0
TOKEN_PORT=8080

# Where the reconciler records last-activity time between cycles.
STATE_FILE=/var/lib/yt-controller/state.json
